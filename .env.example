# Environment for the kitchen app. Copy to `.env` *outside* the repository (or
# into the Container Manager's environment fields) and fill in.
#
# Nothing loads this file automatically — Django reads the process environment.
# In Container Manager, `env_file: ./.env` in the compose file is what supplies
# it; on a development machine, export what you need or just leave the defaults.


# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Off in any deployment. With it on, Django serves tracebacks — including
# settings and environment — to whoever triggers an error.
DJANGO_DEBUG=False

# Required once DEBUG is off. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
# Changing it signs everybody out; it does not affect the recipes.
DJANGO_SECRET_KEY=

# The hostname the reverse proxy forwards. Comma-separated if there are several
# (e.g. the LAN name as well as the public one).
DJANGO_ALLOWED_HOSTS=kitchen.haeusslerr.de

# Origins allowed to POST. Must include the scheme. Without this, every form on
# the real host comes back as a CSRF failure — which looks like the app being
# broken rather than like a missing setting.
DJANGO_CSRF_TRUSTED_ORIGINS=https://kitchen.haeusslerr.de

# Where everything the app writes lives: the database, the photographs, the
# logs. In the container this is a bind mount, so an image update replaces the
# code and leaves the collection alone.
KITCHEN_DATA_DIR=/data

# The machine's clock. Every timestamp shown is read against a clock in the same
# house, so UTC is wrong by an hour or two all summer in a way that looks right.
DJANGO_TIME_ZONE=Europe/Berlin


# ---------------------------------------------------------------------------
# Behind the Synology reverse proxy
# ---------------------------------------------------------------------------

# Trust X-Forwarded-Proto and X-Forwarded-Host. Defaults to on whenever DEBUG is
# off, which is right for this deployment: the proxy is the only way in.
#
# It is what makes the OIDC login work at all. Django builds the redirect_uri
# from the request; without this it goes out as http://… and the SSO server
# rejects it as an unregistered callback. The symptom is a login loop with no
# error message anywhere.
#
# Set to False only if something *else* terminates TLS differently. On a direct
# connection a forwarded header is a client-supplied value and must not be
# trusted.
DJANGO_TRUST_PROXY_HEADERS=True

# How long browsers are told to insist on HTTPS for this hostname. Short by
# default, because an HSTS pin cannot be revoked before it expires. Raise it
# (31536000 = a year) once certificate renewal has run unattended for a cycle
# or two.
DJANGO_HSTS_SECONDS=3600


# ---------------------------------------------------------------------------
# Synology SSO (OIDC)
# ---------------------------------------------------------------------------
# Read the real endpoint URLs off the discovery document before filling these
# in — Synology has moved them between DSM versions. See DEPLOYMENT.md §3.

# With this off, the "Sign in with Synology" button is not offered and the local
# login is the only way in. That is the right setting for a first boot: get in,
# create the fallback account, then switch SSO on.
OIDC_ENABLED=True

OIDC_RP_CLIENT_ID=kitchen-app
OIDC_RP_CLIENT_SECRET=

# The SSO server. The four endpoints below default to Synology's usual paths
# under this base; override any that your DSM version puts elsewhere.
OIDC_OP_BASE=https://sso.haeusslerr.de
#OIDC_OP_AUTHORIZATION_ENDPOINT=
#OIDC_OP_TOKEN_ENDPOINT=
#OIDC_OP_USER_ENDPOINT=
#OIDC_OP_JWKS_ENDPOINT=

# RS256 needs the JWKS endpoint above. HS256 signs with the client secret and
# needs no key fetch — which is the setting to try first if the token exchange
# fails with a signature error on an older DSM.
OIDC_RP_SIGN_ALGO=RS256

# Which DSM users may sign in. Empty means "anybody the SSO server
# authenticates" — right for a household, wrong the moment that server also
# serves guests.
#OIDC_ALLOWED_GROUPS=haushalt

# The claim those group names arrive in, and the group that grants Django admin.
# Some DSM builds send no group claim at all; the app works either way, which is
# why the check above is opt-in rather than the default.
OIDC_GROUPS_CLAIM=groups
#OIDC_STAFF_GROUP=administrators

# Leave this alone. Verification is the whole point of putting these hosts
# behind Let's Encrypt. If the SSO host is only reachable under an internal name
# signed by a private CA, point it at a CA bundle path — never set it to False.
OIDC_VERIFY_SSL=True


# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Days before a session expires. A week: long enough that the household is not
# signing in daily, short enough that a phone left on a train is not permanent.
DJANGO_SESSION_DAYS=7

# The longest edge an uploaded photograph is stored at, and the cap on the
# upload itself. A phone produces 4-6 MB files that are displayed at 800px.
KITCHEN_IMAGE_MAX_EDGE=1600
KITCHEN_IMAGE_MAX_UPLOAD_BYTES=12582912

# Hand /media/ to a reverse proxy instead of serving it from Python. Costs the
# login gate on uploaded photographs, which is why it is not the default.
DJANGO_SERVE_MEDIA=True

# Send the Content-Security-Policy as Report-Only: nothing is blocked and
# violations go to the browser console. For finding out what a new page broke.
# Not a setting to deploy with.
DJANGO_CSP_REPORT_ONLY=False

DJANGO_LOG_LEVEL=INFO
