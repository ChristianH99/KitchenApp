msgstr "Womit sich die Person anmeldet. Buchstaben, Ziffern und . @ + - _"

#: .\apps\accounts\forms.py:145
msgid "Managed by Synology DSM."
msgstr "Wird von Synology DSM verwaltet."

#: .\apps\accounts\forms.py:153 .\apps\accounts\users.py:191
msgid "You cannot switch off your own account."
msgstr "Das eigene Konto lässt sich nicht abschalten."

#: .\apps\accounts\forms.py:162
msgid "You cannot take the administrator right off your own account."
msgstr "Das Administrationsrecht lässt sich dem eigenen Konto nicht entziehen."

#: .\apps\accounts\forms.py:169 .\apps\accounts\users.py:166
#: .\apps\accounts\users.py:198
msgid "This is the last active administrator. Give somebody else the right first."
msgstr "Das ist die letzte aktive Administration. Erst jemand anderem das Recht geben."

#: .\apps\accounts\forms.py:221 .\templates\accounts\sso_settings.html:118
msgid "Client secret"
msgstr "Client-Secret"

#: .\apps\accounts\forms.py:223
msgid "Leave empty to keep the one already stored."
msgstr "Leer lassen, um das bereits gespeicherte zu behalten."

#: .\apps\accounts\forms.py:226
msgid "Remove the stored secret"
msgstr "Gespeichertes Secret entfernen"

#: .\apps\accounts\forms.py:249
msgid "A client secret is needed before Synology sign-in can be switched on."
msgstr "Ohne Client-Secret lässt sich die Synology-Anmeldung nicht einschalten."

#: .\apps\accounts\forms.py:253
msgid "A client ID is needed before Synology sign-in can be switched on."
msgstr "Ohne Client-ID lässt sich die Synology-Anmeldung nicht einschalten."

#: .\apps\accounts\forms.py:267
msgid "Give the SSO server’s address, or fill the authorisation and token endpoints in by hand."
msgstr "Die Adresse des SSO-Servers eintragen — oder Autorisierungs- und Token-Endpunkt von Hand ausfüllen."

#: .\apps\accounts\forms.py:278
msgid "RS256 verifies the token against the provider’s key, so the JWKS address is needed. Use “Read the endpoints from the server”, or choose HS256, which signs with the client secret instead."
msgstr "RS256 prüft das Token gegen den Schlüssel des Anbieters, dafür wird die JWKS-Adresse gebraucht. Entweder „Endpunkte vom Server lesen“ benutzen oder HS256 wählen — das signiert stattdessen mit dem Client-Secret."

#: .\apps\accounts\models.py:42
msgid "RS256 — signed with the provider’s key (needs the JWKS endpoint)"
msgstr "RS256 — mit dem Schlüssel des Anbieters signiert (braucht den JWKS-Endpunkt)"

#: .\apps\accounts\models.py:43
msgid "HS256 — signed with the client secret (no key fetch)"
msgstr "HS256 — mit dem Client-Secret signiert (kein Schlüsselabruf nötig)"

#: .\apps\accounts\models.py:59
msgid "offer Synology sign-in"
msgstr "Synology-Anmeldung anbieten"

#: .\apps\accounts\models.py:60
msgid "With this off, the local password form is the only way in."
msgstr "Ist das aus, führt nur das lokale Passwortformular hinein."

#: .\apps\accounts\models.py:67 .\apps\accounts\sso_views.py:146
msgid "SSO server"
msgstr "SSO-Server"

#: .\apps\accounts\models.py:68
msgid "e.g. https://sso.example.org — the four addresses below are derived from it."
msgstr "z. B. https://sso.example.org — die vier Adressen darunter werden daraus abgeleitet."

#: .\apps\accounts\models.py:70 .\apps\accounts\sso_views.py:147
msgid "authorisation endpoint"
msgstr "Autorisierungs-Endpunkt"

#: .\apps\accounts\models.py:71 .\apps\accounts\sso_views.py:148
msgid "token endpoint"
msgstr "Token-Endpunkt"

#: .\apps\accounts\models.py:72
msgid "user info endpoint"
msgstr "Benutzerinfo-Endpunkt"

#: .\apps\accounts\models.py:73 .\apps\accounts\sso_views.py:149
#: .\templates\accounts\sso_settings.html:103
msgid "JWKS endpoint"
msgstr "JWKS-Endpunkt"

#: .\apps\accounts\models.py:75
msgid "client ID"
msgstr "Client-ID"

#: .\apps\accounts\models.py:80
msgid "signature algorithm"
msgstr "Signaturverfahren"

#: .\apps\accounts\models.py:84
msgid "scopes"
msgstr "Scopes"

#: .\apps\accounts\models.py:85
msgid "Separated by spaces."
msgstr "Durch Leerzeichen getrennt."

#: .\apps\accounts\models.py:89
msgid "allowed groups"
msgstr "erlaubte Gruppen"

#: .\apps\accounts\models.py:90
msgid "Separated by commas. Empty means anybody the SSO server authenticates."
msgstr "Durch Kommas getrennt. Leer heißt: jede und jeder, den der SSO-Server anmeldet."

#: .\apps\accounts\models.py:93
msgid "group claim"
msgstr "Gruppen-Claim"

#: .\apps\accounts\models.py:94
msgid "The claim the group names arrive in. Some DSM versions send none at all."
msgstr "Der Claim, in dem die Gruppennamen ankommen. Manche DSM-Versionen senden gar keinen."

#: .\apps\accounts\models.py:97
msgid "administrator group"
msgstr "Administrationsgruppe"

#: .\apps\accounts\models.py:98
msgid "Members of this group may manage people. Re-applied at every sign-in."
msgstr "Mitglieder dieser Gruppe dürfen Personen verwalten. Wird bei jeder Anmeldung neu übernommen."

#: .\apps\accounts\models.py:102
msgid "verify the certificate"
msgstr "Zertifikat prüfen"

#: .\apps\accounts\models.py:103
msgid "Leave on. Verification is the whole point of putting the SSO server behind a real certificate."
msgstr "Angelassen lassen. Die Prüfung ist der ganze Sinn eines echten Zertifikats vor dem SSO-Server."

#: .\apps\accounts\models.py:113 .\apps\accounts\models.py:114
msgid "SSO configuration"
msgstr "SSO-Konfiguration"

#: .\apps\accounts\sso_views.py:67
msgid "The SSO settings were saved."
msgstr "Die SSO-Einstellungen wurden gespeichert."

#: .\apps\accounts\sso_views.py:103
msgid "Fill in the SSO server’s address first."
msgstr "Zuerst die Adresse des SSO-Servers eintragen."

#: .\apps\accounts\sso_views.py:109
#, python-format
msgid "Could not read the discovery document from %(url)s: %(error)s"
msgstr "Das Discovery-Dokument unter %(url)s ließ sich nicht lesen: %(error)s"

#: .\apps\accounts\sso_views.py:121
msgid "That address answered, but with nothing that looks like a discovery document."
msgstr "Diese Adresse hat geantwortet, aber nicht mit etwas, das nach einem Discovery-Dokument aussieht."

#: .\apps\accounts\sso_views.py:132
msgid "Read from the server. Check the four addresses below, then save."
msgstr "Vom Server gelesen. Die vier Adressen unten prüfen und dann speichern."

#: .\apps\accounts\sso_views.py:156
msgid "There is nothing configured to check yet."
msgstr "Es ist noch nichts eingetragen, das sich prüfen ließe."

#: .\apps\accounts\sso_views.py:206
#, python-format
msgid "answered, HTTP %(code)s"
msgstr "hat geantwortet, HTTP %(code)s"

#: .\apps\accounts\sso_views.py:209
msgid "the certificate was refused — wrong hostname, or an internal CA"
msgstr "das Zertifikat wurde abgelehnt — falscher Hostname oder eine interne CA"

#: .\apps\accounts\sso_views.py:213
msgid "timed out. If a browser can reach this address but the container cannot, it is the router not sending internal traffic back to itself — DEPLOYMENT.md §3.3."
msgstr "Zeitüberschreitung. Wenn ein Browser diese Adresse erreicht und der Container nicht, schickt der Router internen Verkehr nicht zu sich selbst zurück — DEPLOYMENT.md §3.3."

#: .\apps\accounts\sso_views.py:221
msgid "the name could not be resolved from inside the container"
msgstr "der Name ließ sich aus dem Container heraus nicht auflösen"

#: .\apps\accounts\sso_views.py:223
msgid "the connection was refused — nothing is listening on that port"
msgstr "die Verbindung wurde abgewiesen — auf diesem Port hört nichts zu"

#: .\apps\accounts\sso_views.py:224
msgid "no connection could be made"
msgstr "es kam keine Verbindung zustande"

#: .\apps\accounts\sso_views.py:227
msgid "the request failed"
msgstr "die Anfrage ist fehlgeschlagen"

