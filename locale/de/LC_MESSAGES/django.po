msgid_plural "and %(n)s more"
msgstr[0] "und %(n)s weiteres"
msgstr[1] "und %(n)s weitere"

#: .\templates\recipes\tag_list.html:33
msgid "No tags yet"
msgstr "Noch keine Tags"

#: .\templates\recipes\tag_list.html:34
msgid ""
"Tags appear here once recipes carry them. Add “soup”, “vegetarian” or "
"“Sunday” to a recipe and it becomes a way to find it again."
msgstr "Tags erscheinen hier, sobald Rezepte welche tragen. „Suppe“, „vegetarisch“ oder „Sonntag“ an ein Rezept hängen — schon ist es darüber wiederzufinden."

#: .\templates\recipes\tag_list.html:35
msgid "Go to the recipes"
