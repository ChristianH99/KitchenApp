msgid "Password"
msgstr "Passwort"

#: .\apps\accounts\forms.py:52 .\templates\accounts\user_form.html:60
#: .\templates\accounts\user_password.html:25
msgid "Repeat password"
msgstr "Passwort wiederholen"

#: .\apps\accounts\forms.py:60
msgid "The two passwords do not match."
msgstr "Die beiden Passwörter stimmen nicht überein."

#: .\apps\accounts\forms.py:89
msgid "What they type to sign in. Letters, digits and . @ + - _"
msgstr "Womit sich die Person anmeldet. Buchstaben, Ziffern und . @ + - _"

#: .\apps\accounts\forms.py:145
msgid "Managed by the identity provider."
msgstr "Wird vom Identitätsanbieter verwaltet."

#: .\apps\accounts\forms.py:153 .\apps\accounts\users.py:196
msgid "You cannot switch off your own account."
msgstr "Das eigene Konto lässt sich nicht abschalten."

#: .\apps\accounts\forms.py:162
msgid "You cannot take the administrator right off your own account."
msgstr "Das Administrationsrecht lässt sich dem eigenen Konto nicht entziehen."

#: .\apps\accounts\forms.py:169 .\apps\accounts\users.py:171
#: .\apps\accounts\users.py:203
msgid "This is the last active administrator. Give somebody else the right first."
msgstr "Das ist die letzte aktive Administration. Erst jemand anderem das Recht geben."

#: .\apps\accounts\forms.py:221 .\templates\accounts\sso_settings.html:170
msgid "Client secret"
msgstr "Client-Secret"

#: .\apps\accounts\forms.py:223
msgid "Leave empty to keep the one already stored."
msgstr "Leer lassen, um das bereits gespeicherte zu behalten."

#: .\apps\accounts\forms.py:226
msgid "Remove the stored secret"
msgstr "Gespeichertes Secret entfernen"

#: .\apps\accounts\forms.py:250
msgid "A client secret is needed before Synology sign-in can be switched on."
msgstr "Ohne Client-Secret lässt sich die Synology-Anmeldung nicht einschalten."

#: .\apps\accounts\forms.py:254
msgid "A client ID is needed before Synology sign-in can be switched on."
msgstr "Ohne Client-ID lässt sich die Synology-Anmeldung nicht einschalten."

#: .\apps\accounts\forms.py:268
msgid "Give the SSO server’s address, or fill the authorisation and token endpoints in by hand."
msgstr "Die Adresse des SSO-Servers eintragen — oder Autorisierungs- und Token-Endpunkt von Hand ausfüllen."

#: .\apps\accounts\forms.py:286
msgid "RS256 verifies the token against the provider’s key, so the JWKS address is needed and could not be read from this server. Check the address, fill the endpoints in by hand below, or choose HS256, which signs with the client secret instead."
msgstr "RS256 prüft das Token gegen den Schlüssel des Anbieters, dafür wird die JWKS-Adresse gebraucht — und die konnte von diesem Server nicht gelesen werden. Prüfe die Adresse, trage die Endpunkte unten von Hand ein, oder wähle HS256 — das signiert stattdessen mit dem Client-Secret."

#: .\apps\accounts\models.py:49
msgid "RS256 — signed with the provider’s key (needs the JWKS endpoint)"
msgstr "RS256 — mit dem Schlüssel des Anbieters signiert (braucht den JWKS-Endpunkt)"

#: .\apps\accounts\models.py:50
msgid "HS256 — signed with the client secret (no key fetch)"
msgstr "HS256 — mit dem Client-Secret signiert (kein Schlüsselabruf nötig)"

#: .\apps\accounts\models.py:66
msgid "offer single sign-on"
msgstr "Single Sign-on anbieten"

#: .\apps\accounts\models.py:67
msgid "With this off, the local password form is the only way in."
msgstr "Ist das aus, führt nur das lokale Passwortformular hinein."

#: .\apps\accounts\models.py:80 .\apps\accounts\sso_views.py:325
msgid "SSO server"
msgstr "SSO-Server"

#: .\apps\accounts\models.py:82
msgid "The issuer, e.g. https://sso.example.org — or paste the full …/.well-known/openid-configuration address if that is what your provider gives you."
msgstr "Der Issuer, z. B. https://sso.example.org — oder füge die vollständige Adresse auf …/.well-known/openid-configuration ein, falls der Anbieter dir diese nennt."

#: .\apps\accounts\models.py:86 .\apps\accounts\sso_views.py:326
msgid "authorisation endpoint"
msgstr "Autorisierungs-Endpunkt"

#: .\apps\accounts\models.py:87 .\apps\accounts\sso_views.py:327
msgid "token endpoint"
msgstr "Token-Endpunkt"

#: .\apps\accounts\models.py:88
msgid "user info endpoint"
msgstr "Benutzerinfo-Endpunkt"

#: .\apps\accounts\models.py:89 .\apps\accounts\sso_views.py:328
#: .\templates\accounts\sso_settings.html:154
msgid "JWKS endpoint"
msgstr "JWKS-Endpunkt"

#: .\apps\accounts\models.py:97
msgid "client ID"
msgstr "Client-ID"

#: .\apps\accounts\models.py:102
msgid "signature algorithm"
msgstr "Signaturverfahren"

#: .\apps\accounts\models.py:106
msgid "scopes"
msgstr "Scopes"

#: .\apps\accounts\models.py:107
msgid "Separated by spaces."
msgstr "Durch Leerzeichen getrennt."

#: .\apps\accounts\models.py:111
msgid "allowed groups"
msgstr "erlaubte Gruppen"

#: .\apps\accounts\models.py:112
msgid "Separated by commas. Empty means anybody the SSO server authenticates."
msgstr "Durch Kommas getrennt. Leer heißt: jede und jeder, den der SSO-Server anmeldet."

#: .\apps\accounts\models.py:115
msgid "group claim"
msgstr "Gruppen-Claim"

#: .\apps\accounts\models.py:116
msgid "The claim the group names arrive in. Some providers send none at all."
msgstr "Der Claim, in dem die Gruppennamen ankommen. Manche Anbieter senden gar keinen."

#: .\apps\accounts\models.py:119
msgid "administrator group"
msgstr "Administrationsgruppe"

#: .\apps\accounts\models.py:120
msgid "Members of this group may manage people. Re-applied at every sign-in."
msgstr "Mitglieder dieser Gruppe dürfen Personen verwalten. Wird bei jeder Anmeldung neu übernommen."

#: .\apps\accounts\models.py:124
msgid "verify the certificate"
msgstr "Zertifikat prüfen"

#: .\apps\accounts\models.py:125
msgid "Leave on. Verification is the whole point of putting the SSO server behind a real certificate."
msgstr "Angelassen lassen. Die Prüfung ist der ganze Sinn eines echten Zertifikats vor dem SSO-Server."

#: .\apps\accounts\models.py:135
msgid "request timeout"
msgstr "Zeitlimit für Anfragen"

#: .\apps\accounts\models.py:136
msgid "Seconds to wait for the provider before giving up."
msgstr "Sekunden, die auf den Anbieter gewartet wird, bevor abgebrochen wird."

#: .\apps\accounts\models.py:146 .\apps\accounts\models.py:147
msgid "SSO configuration"
msgstr "SSO-Konfiguration"

#: .\apps\accounts\models.py:328
msgid "chime — two soft notes"
msgstr "Glockenspiel — zwei weiche Töne"

#: .\apps\accounts\models.py:329
msgid "bell — one long ring"
msgstr "Glocke — ein langer Ton"

#: .\apps\accounts\models.py:330
msgid "beeps — three short tones"
msgstr "Piepen — drei kurze Töne"

#: .\apps\accounts\models.py:331
msgid "alarm — insistent, for a noisy kitchen"
msgstr "Alarm — aufdringlich, für eine laute Küche"

