#: .\static\js\recipe_diagram.js:485
msgid "Takes in what comes out of: %(steps)s"
msgstr "Nimmt auf, was herauskommt aus: %(steps)s"

#: .\static\js\recipe_diagram.js:488 .\static\js\recipe_diagram.js:725
#: .\static\js\recipe_diagram.js:747 .\static\js\recipe_diagram.js:1303
msgid "Step %(n)s"
msgstr "Schritt %(n)s"

#: .\static\js\recipe_diagram.js:696 .\static\js\recipe_diagram.js:1303
msgid "Line %(n)s"
msgstr "Zeile %(n)s"

#: .\static\js\recipe_diagram.js:1308
msgid "%(line)s is now in “%(step)s”"
msgstr "%(line)s liegt jetzt in „%(step)s“"

#: .\static\js\recipe_diagram.js:1313
msgid "%(line)s is not in any step"
msgstr "%(line)s liegt in keinem Schritt"

#: .\static\js\recipe_diagram.js:1318
msgid "%(step)s now feeds into “%(parent)s”"
msgstr "%(step)s mündet jetzt in „%(parent)s“"

#: .\static\js\recipe_diagram.js:1323
msgid "%(step)s no longer feeds into anything"
msgstr "%(step)s mündet in nichts mehr"

#: .\static\js\recipe_diagram.js:1330
msgid "%(step)s is now %(n)s of %(total)s"
msgstr "%(step)s ist jetzt %(n)s von %(total)s"

#: .\static\js\recipe_diagram.js:1552 .\static\js\recipe_diagram.js:1553
msgid "Drag to change which ingredients go into this step"
msgstr "Ziehen, um zu ändern, welche Zutaten in diesen Schritt gehen"

#: .\static\js\recipe_diagram.js:1578
msgid "Drag to change where this step starts"
msgstr "Ziehen, um zu ändern, wo dieser Schritt beginnt"

#: .\static\js\recipe_diagram.js:1579
msgid "Drag to change how far this step reaches"
msgstr "Ziehen, um zu ändern, wie weit dieser Schritt reicht"

#: .\static\js\recipe_diagram.js:1993
